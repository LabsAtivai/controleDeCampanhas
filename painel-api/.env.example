# Token que o painel (frontend) deve enviar no header X-API-Token
PAINEL_TOKEN=troque-por-um-token-forte

# Domínio do painel publicado no Vercel, para liberar CORS
# ex: https://painel-campanhas.vercel.app
FRONTEND_ORIGIN=*

# Banco MySQL principal (dadoscampanha)
DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/dadoscampanha

# Cross-DB só-leitura pro resumo por squad (dadoscampanha + relatoriolistas.listas_squad)
LISTAS_SQUAD_DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/relatoriolistas

# Sistema de credenciais (snov-am-api) — mesmo usado pelo painel_listas.
CREDENTIALS_API_URL=
CREDENTIALS_API_KEY=
