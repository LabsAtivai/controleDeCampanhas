# Produção: configure antes de iniciar. Nunca versionar o .env.
DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/dadoscampanha
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=true
TRUST_PROXY=true
ALLOW_LEGACY_TOKEN=false
# Compatibilidade opcional; o painel da equipe usa login individual.
PAINEL_TOKEN=

CREDENTIALS_API_URL=
CREDENTIALS_API_KEY=
AVANCOS_API_URL=http://avancos-backend:3098/api
AVANCOS_API_KEY=
AVANCOS_API_KEY_HEADER=X-API-Key
AVANCOS_FRONTEND_URL=
ALLOW_INSECURE_INTEGRATIONS=false
SEMAFORO_TIPOS=Interessado
INTEGRATION_MAX_STALE_SECONDS=86400

# Opcional: sem conexão externa, use a tabela local painel_squad_mapping.
LISTAS_SQUAD_DATABASE_URL=
SQUAD_MAPPING_TABLE=relatoriolistas.listas_squad

GOOGLE_SHEETS_ENABLED=true
GOOGLE_MASTER_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=/run/secrets/google_credentials
# Caminho no host; pode reutilizar a credencial existente, sem revogação.
GOOGLE_CREDENTIALS_HOST_PATH=./sheets.googleapis.com-python.json

# Necessário para o perfil HTTPS do Compose.
PUBLIC_DOMAIN=
TLS_EMAIL=
ALERT_WEBHOOK_URL=
BACKUP_DIRECTORY=/backups
SNOV_REQUEST_INTERVAL=1
