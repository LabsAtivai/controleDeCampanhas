# Modelo de produção. Copie para .env no servidor e preencha. Nunca versionar o .env.
# Obrigatórias (o Compose recusa subir sem elas):
DATABASE_URL=mysql+pymysql://USUARIO:SENHA@HOST:3306/dadoscampanha
SECRET_KEY=            # aleatória e longa: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
CREDENTIALS_API_URL=http://snov-am-api:8000   # rede docker "ativaai"; evita HTTP em IP público
CREDENTIALS_API_KEY=
AVANCOS_API_URL=http://avancos-backend:3098/api
AVANCOS_API_KEY=

# Recomendadas:
COOKIE_SECURE=true
TRUST_PROXY=true
ALLOW_LEGACY_TOKEN=false
ALLOW_INSECURE_INTEGRATIONS=false
AVANCOS_FRONTEND_URL=        # URL do frontend do sistema oficial de avanços
SEMAFORO_TIPOS=Interessado

# Squads (banco de outro sistema, só leitura):
LISTAS_SQUAD_DATABASE_URL=
SQUAD_MAPPING_TABLE=relatoriolistas.listas_squad

# Planilhas Google (o padrão do Compose é desligado):
GOOGLE_SHEETS_ENABLED=true
GOOGLE_MASTER_SHEET_ID=
GOOGLE_CREDENTIALS_HOST_PATH=/caminho/no/host/credencial.json

# HTTPS (perfil "https" do Compose):
PUBLIC_DOMAIN=
TLS_EMAIL=
ALERT_WEBHOOK_URL=
BACKUP_DIRECTORY=/backups
SNOV_REQUEST_INTERVAL=1
